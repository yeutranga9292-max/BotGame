# Mezon Bot credentials (https://mezon.ai/developers)
MEZON_BOT_ID=your_bot_id_here
MEZON_BOT_TOKEN=your_bot_token_here

# Optional Mezon overrides
# MEZON_HOST=gw.mezon.ai
# MEZON_PORT=443
# MEZON_USE_SSL=true

# Neon Postgres connection string
# Example: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Bot config
BOT_PREFIX=!
PORT=3000
DAILY_WORD_CRON=0 8 * * *
